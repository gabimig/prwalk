+import { describe, expect, it } from 'vitest';
+import { LoginRateLimiter } from '../../src/auth/rateLimiter';
+import { memoryStore } from '../helpers/memoryStore';
+
+describe('LoginRateLimiter', () => {
+  it('blocks after the maximum number of attempts', async () => {
+    const limiter = new LoginRateLimiter(memoryStore());
+    for (let i = 0; i < 5; i++) await limiter.registerFailure('a@example.com');
+    expect(await limiter.isBlocked('a@example.com')).toBe(true);
+  });
+
+  it('does not block below the maximum', async () => {
+    const limiter = new LoginRateLimiter(memoryStore());
+    for (let i = 0; i < 4; i++) await limiter.registerFailure('a@example.com');
+    expect(await limiter.isBlocked('a@example.com')).toBe(false);
+  });
+
+  it('forgets the attempts when the window expires', async () => {
+    const store = memoryStore();
+    const limiter = new LoginRateLimiter(store);
+    for (let i = 0; i < 5; i++) await limiter.registerFailure('a@example.com');
+    store.advance(15 * 60);
+    expect(await limiter.isBlocked('a@example.com')).toBe(false);
+  });
+
+  it('resets the counter', async () => {
+    const limiter = new LoginRateLimiter(memoryStore());
+    for (let i = 0; i < 5; i++) await limiter.registerFailure('a@example.com');
+    await limiter.reset('a@example.com');
+    expect(await limiter.isBlocked('a@example.com')).toBe(false);
+  });
+});
