+import { Store } from '../store';
+import { authConfig } from '../config/auth';
+
+export class LoginRateLimiter {
+  constructor(private store: Store) {}
+
+  async isBlocked(email: string): Promise<boolean> {
+    const attempts = await this.store.get(this.key(email));
+    return Number(attempts ?? 0) >= authConfig.maxAttempts;
+  }
+
+  async registerFailure(email: string): Promise<void> {
+    const key = this.key(email);
+    const attempts = await this.store.incr(key);
+    if (attempts === 1) {
+      await this.store.expire(key, authConfig.windowSeconds);
+    }
+  }
+
+  async reset(email: string): Promise<void> {
+    await this.store.del(this.key(email));
+  }
+
+  private key(email: string) {
+    return `login:attempts:${email.toLowerCase()}`;
+  }
+}
